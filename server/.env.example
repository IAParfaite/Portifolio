# Server environment variables — copy to server/.env and fill in

# Port for the API
PORT=5000

# Origin allowed to call the API (your React dev server / production URL)
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB (optional but recommended) ---
# Leave empty to run with an in-memory fallback (submissions are not persisted).
# Get a free cluster at https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.mongodb.net/portfolio

# --- Nodemailer (optional email notifications) ---
# Example using Gmail app password: set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# SMTP_SECURE should be 'true' for SMTP_PORT=465, otherwise omit/false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where notifications are sent (usually your own email)
EMAIL_TO=